# Upstream Kitoboy services (in-network docker hostnames by default)
KITOBOY_API_URL=http://api:3052
ZOO_URL=http://zoo:8000

# Volunteer credentials used by the server to obtain a JWT (POST /login).
# Match Kitoboy's UI_USER / UI_PASSWORD.
KITOBOY_USER=user
KITOBOY_PASSWORD=user

# MCP Streamable HTTP endpoint (container always serves on MCP_PORT)
MCP_HOST=0.0.0.0
MCP_PORT=9000
# Host port to publish the endpoint on (only used by docker-compose).
MCP_PUBLISH_PORT=9000
# Optional: protect the MCP endpoint with a static bearer token (leave empty to disable)
MCP_AUTH_TOKEN=

# HTTP / startup tuning
REQUEST_TIMEOUT=30.0
LOGIN_MAX_RETRIES=30
LOGIN_RETRY_DELAY=2.0
